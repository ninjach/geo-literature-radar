# Literature metadata sources
# USE_OPENALEX=1
# USE_CROSSREF=1
# OPENALEX_API_KEY=free-key-from-openalex
# OPENALEX_MAILTO=your-email@example.com
# CROSSREF_MAILTO=your-email@example.com
# OPENALEX_BATCH_SIZE=6
# MAX_SOURCE_RETRIES=3

# Server and refresh settings
# PORT=8051
# PER_JOURNAL=10
# STATIC_WINDOW_MONTHS=12
# FETCH_TIMEOUT_MS=24000
# JOURNAL_TIMEOUT_MS=36000
# FETCH_CONCURRENCY=2
# REQUEST_STAGGER_MS=650

# Paper titles, keywords and abstracts remain in publisher-provided English.
# No translation or generated-summary API is exposed by this version.
